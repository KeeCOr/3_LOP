{
    "name":  "lop",
    "version":  "0.4.22",
    "description":  "lop",
    "main":  "main.js",
    "scripts":  {
                    "start":  "electron .",
                    "dist":  "electron-builder --win --x64"
                },
    "build":  {
                  "appId":  "com.pioneer.game",
                  "productName":  "lop",
                  "copyright":  "Copyright 2026",
                  "win":  {
                              "target":  [
                                             {
                                                 "target":  "portable",
                                                 "arch":  [
                                                              "x64"
                                                          ]
                                             }
                                         ],
                              "icon":  "icon.ico",
                              "signAndEditExecutable":  false,
                              "forceCodeSigning":  false
                          },
                  "portable":  {
                                   "artifactName":  "LOP_v0.4.22_portable.exe"
                               },
                  "files":  [
                                "main.js",
                                "dist/**/*"
                            ],
                  "directories":  {
                                      "output":  "C:\\Development\\3_LOP\\release"
                                  }
              },
    "devDependencies":  {
                            "electron":  "^33.0.0",
                            "electron-builder":  "^24.0.0"
                        }
}
